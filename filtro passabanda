def Cesaro_Fractal(ordem, angulo,perimetro,pontoinicial=[0,0]):
    rad = pi / 180
    listapontos = []
    raio = (perimetro) / ((4 * (4) ** ordem))

    listapontos.append(("{}mm".format(pontoinicial[0]), "{}mm".format(pontoinicial[1]), "0mm"))
    grausinicial = ["0"]
    graus = []
    for c in range(0, ordem):
	    graus = []
	    graus.extend(grausinicial)
	    graus60 = [str(c)+"+(angulo*pi/180)" for c in grausinicial]
	    graus.extend(graus60)
	    graus300 = [str(c)+"+(360*pi/180-(angulo*pi/180))" for c in grausinicial]
	    graus.extend(graus300)
	    graus.extend(grausinicial)
	    grausinicial = []
	    grausinicial.extend(graus)


    lado2 = [str(c)+"+(90*pi/180)" for c in graus]
    lado3 = [str(c)+"+(180*pi/180)" for c in graus]
    lado4 = [str(c)+"+(270*pi/180)" for c in graus]

    graus.extend(lado2)
    graus.extend(lado3)
    graus.extend(lado4)
    #print(graus)
    return graus


